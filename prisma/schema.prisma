generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Composer {
  id           String        @id @default(cuid())
  name         String
  biography    String?
  imageUrl     String?
  ankitaId     String
  timeline     String?
  guruId       String?
  guru         Composer?     @relation("GuruShishya", fields: [guruId], references: [id])
  shishyas     Composer[]    @relation("GuruShishya")
  ankita       Ankita        @relation(fields: [ankitaId], references: [id])
  compositions Composition[]
}

model Composition {
  id                String             @id @default(cuid())
  title             String
  firstLine         String
  lyrics            String
  transliteration   String?
  composerId        String
  deityId           String
  ankitaId          String
  ragaId            String?
  talaId            String?
  audioFiles        AudioFile[]
  ankita            Ankita             @relation(fields: [ankitaId], references: [id])
  composer          Composer           @relation(fields: [composerId], references: [id])
  deity             Deity              @relation(fields: [deityId], references: [id])
  raga              Raga?              @relation(fields: [ragaId], references: [id])
  tala              Tala?              @relation(fields: [talaId], references: [id])
  dailyCompositions DailyComposition[]
  translations      Translation[]
  tags              Tag[]              @relation("CompositionToTag")
  themes            Theme[]            @relation("CompositionToTheme")
}

model Raga {
  id           String        @id @default(cuid())
  name         String        @unique
  compositions Composition[]
}

model Tala {
  id           String        @id @default(cuid())
  name         String        @unique
  compositions Composition[]
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  compositions Composition[] @relation("CompositionToTag")
}

model Ankita {
  id           String        @id @default(cuid())
  name         String        @unique
  composers    Composer[]
  compositions Composition[]
}

model Deity {
  id           String        @id @default(cuid())
  name         String        @unique
  imageUrl     String?
  compositions Composition[]
}

model Translation {
  id             String      @id @default(cuid())
  compositionId  String
  english        String
  kannadaMeaning String
  wordByWord     String
  composition    Composition @relation(fields: [compositionId], references: [id])
}

model AudioFile {
  id            String      @id @default(cuid())
  compositionId String
  title         String
  url           String
  composition   Composition @relation(fields: [compositionId], references: [id])
}

model Theme {
  id           String        @id @default(cuid())
  name         String        @unique
  compositions Composition[] @relation("CompositionToTheme")
}

model DailyComposition {
  id            String      @id @default(cuid())
  date          DateTime    @unique
  compositionId String
  commentary    String
  isEditorial   Boolean     @default(false)
  composition   Composition @relation(fields: [compositionId], references: [id])
}

model UserStreak {
  id       String   @id @default(cuid())
  userId   String   @unique
  count    Int      @default(0)
  lastDate DateTime
}

model Reflection {
  id            String   @id @default(cuid())
  userId        String
  compositionId String
  note          String
  createdAt     DateTime @default(now())
}
